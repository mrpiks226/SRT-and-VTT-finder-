{
  "manifest_version": 3,
  "name": "SubSniffer Pro",
  "version": "1.0",
  "description": "Finds VTT and SRT files on any page.",
  "permissions": [
    "webRequest",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
